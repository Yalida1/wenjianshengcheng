APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-value-at-least-32-characters
DATABASE_URL=postgresql+psycopg://docchain:docchain@postgres:5432/docchain
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=docchain
S3_SECRET_KEY=change-this-minio-password
S3_BUCKET=project-documents
S3_REGION=us-east-1
STORAGE_BACKEND=s3
LLM_PROVIDER=demo
# 真实 AI：可在「系统管理 → 模型配置」添加并启用；也可用下方环境变量作为回退。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=90
PROCUREMENT_PLANNING_ENABLED=true
PROCUREMENT_ANALYSIS_CHUNK_CHARS=24000
PROCUREMENT_ANALYSIS_MAX_PARALLEL_CHUNKS=3
PROCUREMENT_ANALYSIS_SOFT_TIME_LIMIT_SECONDS=1800
PROCUREMENT_ANALYSIS_TIME_LIMIT_SECONDS=1860
PROCUREMENT_ANALYSIS_STALE_AFTER_SECONDS=300
PROCUREMENT_ANALYSIS_RECOVERY_INTERVAL_SECONDS=60
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://localhost:8443
MAX_UPLOAD_BYTES=52428800
DEMO_ADMIN_ACCOUNT=admin
DEMO_ADMIN_PASSWORD=admin123

# 前端品牌默认值可在「系统管理 → 品牌设置」运行时修改；以下仅作构建期回退（可选）
# VITE_BRAND_NAME=智能招标管理
# VITE_BRAND_SUBTITLE=受控生成与定稿平台
# VITE_BRAND_LOGO_URL=/brand-logo.svg
# VITE_BRAND_MARK=智
# VITE_BRAND_DOCUMENT_TITLE=智能招标管理
