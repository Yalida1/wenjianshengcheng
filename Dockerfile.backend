FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 install -y --no-install-recommends \
        curl \
        fonts-noto-cjk \
        libreoffice-writer \
        poppler-utils \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system docchain \
    && useradd --system --gid docchain --create-home --home-dir /home/docchain docchain

WORKDIR /app
COPY pyproject.toml alembic.ini ./
COPY backend ./backend
RUN pip install --no-cache-dir .

COPY scripts/docker-entrypoint.sh /usr/local/bin/docchain-entrypoint
RUN chmod +x /usr/local/bin/docchain-entrypoint \
    && chown -R docchain:docchain /app /home/docchain

EXPOSE 8000
ENV HOME=/home/docchain
USER docchain
ENTRYPOINT ["docchain-entrypoint"]
